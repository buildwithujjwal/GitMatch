<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' — GitMatch' : 'GitMatch' %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <% if (typeof showNav !== 'undefined' && showNav) { %>
  <nav>
    <span class="brand">GitMatch</span>
    <a href="/discover" class="<%= page === 'discover' ? 'active' : '' %>">Discover</a>
    <a href="/saved" class="<%= page === 'saved' ? 'active' : '' %>">Saved</a>
    <a href="/profile" class="<%= page === 'profile' ? 'active' : '' %>">Profile</a>
    <a href="/logout">Logout</a>
  </nav>
  <% } %>

  <div class="container">
    <%- body %>
  </div>

  <script src="/js/main.js"></script>
</body>
</html>