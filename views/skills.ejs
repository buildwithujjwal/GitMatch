<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pick Skills — GitMatch</title>
  <link rel="stylesheet" href="/css/skills.css" />
</head>
<body class="dark">

  <%- include('partials/header') %>

  <!-- Main Content -->
  <div class="container">

    <!-- Header -->
    <div class="header">
      <div>
        <h1 class="title">
          Pick your skills
          <span class="selected-count" id="selected-count" style="display:none"></span>
        </h1>
        <p class="subtitle">Select languages and tools — we'll find repos with open issues that match.</p>
      </div>
    </div>

    <form action="/skills" method="POST">

      <!-- From GitHub -->
      <% if (userLangs.length > 0) { %>
      <div class="section">
        <div class="section-title">
          From your GitHub
          <span class="section-badge">auto-detected</span>
        </div>
        <div class="tag-list">
          <% userLangs.forEach(lang => { %>
            <label class="skill-label">
              <input
                type="checkbox"
                name="skills"
                value="<%= lang %>"
                <%= selected.includes(lang) ? 'checked' : '' %>
              />
              <span class="skill-tag"><%= lang %></span>
            </label>
          <% }) %>
        </div>
      </div>
      <% } %>

      <!-- Languages -->
      <div class="section">
        <div class="section-title">Languages</div>
        <div class="tag-list">
          <% skills.languages.forEach(lang => { %>
            <label class="skill-label">
              <input
                type="checkbox"
                name="skills"
                value="<%= lang %>"
                <%= selected.includes(lang) ? 'checked' : '' %>
              />
              <span class="skill-tag"><%= lang %></span>
            </label>
          <% }) %>
        </div>
      </div>

      <!-- Frameworks & Tools -->
      <div class="section">
        <div class="section-title">Frameworks &amp; Tools</div>
        <div class="tag-list">
          <% skills.frameworks.forEach(skill => { %>
            <label class="skill-label">
              <input
                type="checkbox"
                name="skills"
                value="<%= skill %>"
                <%= selected.includes(skill) ? 'checked' : '' %>
              />
              <span class="skill-tag"><%= skill %></span>
            </label>
          <% }) %>
        </div>
      </div>

      <button type="submit" id="submit-btn" disabled>
        Find issues
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>

    </form>
  </div>

  <script src="/js/PickSkills.js"></script>
</body>
</html>
