<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Profile — GitMatch</title>
  <link rel="stylesheet" href="/css/profile.css" />
</head>
<body class="dark">

  <%- include('partials/header') %>

  <!-- Main Content -->
  <div class="container">

    <!-- Profile Card -->
    <div class="profile-card">
      <img src="<%= user.avatar %>" alt="<%= user.username %>" class="avatar" />
      <div class="profile-info">
        <h2><%= user.name %></h2>
        <p class="username">@<%= user.username %></p>
        <% if (user.bio) { %>
          <p class="bio"><%= user.bio %></p>
        <% } %>
        <% if (user.location) { %>
          <p class="meta">📍 <%= user.location %></p>
        <% } %>
        <div class="stats">
          <span><strong><%= user.public_repos %></strong> repos</span>
          <span><strong><%= user.followers %></strong> followers</span>
          <span><strong><%= user.following %></strong> following</span>
        </div>
      </div>
    </div>

    <!-- Languages -->
<% const langs = Object.entries(user.languages || {}).sort((a,b) => b[1]-a[1]).slice(0,8) %>
<% if (langs.length > 0) { %>
<div class="section">
  <h3>Your languages</h3>

  <%
    const total = langs.reduce((sum, [, count]) => sum + count, 0);
    const langColors = {
      "JavaScript": "#f1e05a", "TypeScript": "#3178c6", "Python": "#3572A5",
      "HTML": "#e34c26", "CSS": "#563d7c", "Java": "#b07219",
      "C++": "#f34b7d", "C": "#555555", "C#": "#178600",
      "Ruby": "#701516", "Go": "#00ADD8", "Rust": "#dea584",
      "PHP": "#4F5D95", "Shell": "#89e051", "Dart": "#00B4AB",
      "HTML/CSS": "#e34c26", "Swift": "#F05138", "Kotlin": "#A97BFF"
    };
    const defaultColors = ["#8b949e","#6e7681","#484f58"];
  %>

  <div style="display:flex; width:100%; height:10px; border-radius:6px; overflow:hidden; gap:2px; margin-bottom:12px;">
    <% langs.forEach(([lang, count], i) => {
      const pct = ((count / total) * 100).toFixed(1);
      const color = langColors[lang] || defaultColors[i % defaultColors.length];
    %>
      <span style="display:block; width:<%= pct %>%; height:100%; background:<%= color %>; border-radius:2px;" title="<%= lang %> <%= pct %>%"></span>
    <% }) %>
  </div>

  <div style="display:flex; flex-wrap:wrap; gap:8px 16px;">
    <% langs.forEach(([lang, count], i) => {
      const pct = ((count / total) * 100).toFixed(1);
      const color = langColors[lang] || defaultColors[i % defaultColors.length];
    %>
      <span style="display:flex; align-items:center; gap:6px; font-size:13px;">
        <span style="width:10px; height:10px; border-radius:50%; background:<%= color %>; flex-shrink:0;"></span>
        <%= lang %> <span style="opacity:0.6;"><%= pct %>%</span>
      </span>
    <% }) %>
  </div>

</div>
<% } %>

    <!-- Topics -->
    <% const topics = Object.entries(user.topics || {}).sort((a,b) => b[1]-a[1]).slice(0,10) %>
    <% if (topics.length > 0) { %>
    <div class="section">
      <h3>Your topics</h3>
      <div class="tag-list">
        <% topics.forEach(([topic]) => { %>
          <span class="tag"><%= topic %></span>
        <% }) %>
      </div>
    </div>
    <% } %>

    <!-- CTA -->
    <a href="/skills" class="btn">
      Pick skills &amp; discover repos
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>

  </div>

  <script src="/js/profile.js"></script>
</body>
</html>
