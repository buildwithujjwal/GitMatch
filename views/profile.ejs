<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Profile — GitMatch</title>
  <link rel="stylesheet" href="/css/profile.css" />
</head>
<body class="dark">

  <%- include('partials/header') %>

  <!-- Main Content -->
  <div class="container">

    <!-- Profile Card -->
    <div class="profile-card">
      <img src="<%= user.avatar %>" alt="<%= user.username %>" class="avatar" />
      <div class="profile-info">
        <h2><%= user.name %></h2>
        <p class="username">@<%= user.username %></p>
        <% if (user.bio) { %>
          <p class="bio"><%= user.bio %></p>
        <% } %>
        <% if (user.location) { %>
          <p class="meta">📍 <%= user.location %></p>
        <% } %>
        <div class="stats">
          <span><strong><%= user.public_repos %></strong> repos</span>
          <span><strong><%= user.followers %></strong> followers</span>
          <span><strong><%= user.following %></strong> following</span>
        </div>
      </div>
    </div>

    <!-- Languages -->
    <% const langs = Object.entries(user.languages || {}).sort((a,b) => b[1]-a[1]).slice(0,8) %>
    <% if (langs.length > 0) { %>
    <div class="section">
      <h3>Your languages</h3>
      <div class="tag-list">
        <% langs.forEach(([lang, count]) => { %>
          <span class="tag">
            <%= lang %>
            <span class="tag-count"><%= count %></span>
          </span>
        <% }) %>
      </div>
    </div>
    <% } %>

    <!-- Topics -->
    <% const topics = Object.entries(user.topics || {}).sort((a,b) => b[1]-a[1]).slice(0,10) %>
    <% if (topics.length > 0) { %>
    <div class="section">
      <h3>Your topics</h3>
      <div class="tag-list">
        <% topics.forEach(([topic]) => { %>
          <span class="tag"><%= topic %></span>
        <% }) %>
      </div>
    </div>
    <% } %>

    <!-- CTA -->
    <a href="/skills" class="btn">
      Pick skills &amp; discover repos
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>

  </div>

  <script src="/js/profile.js"></script>
</body>
</html>
